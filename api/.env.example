# Enable Banking — sandbox application
EB_SANDBOX_APP_ID=4fa7736c-d1bb-4b2a-87ea-9cd052b643b8
# On Railway use the BASE64 form — a raw PEM loses its header line in transit:
#   base64 -i sandbox.pem | tr -d '\n'
# EB_SANDBOX_PRIVATE_KEY_B64=LS0tLS1CRUdJTi...
# Locally a path is easiest:
EB_SANDBOX_KEY_PATH=/absolute/path/to/sandbox.pem
# EB_SANDBOX_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Enable Banking — production application (inactive until accounts are linked)
EB_PRODUCTION_APP_ID=2fec743e-2756-4635-a086-ea2708b78fcf
EB_PRODUCTION_KEY_PATH=/absolute/path/to/production.pem

# Where the bank sends the user back. MUST be registered in the EB control panel.
# Production applications reject http:// — HTTPS only.
EB_REDIRECT_URL=http://localhost:5173/callback

# The SPA origin(s) allowed to call this API. Comma-separated.
WEB_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://web-production-acf5c.up.railway.app

# Auth0 — requires an API registered in Auth0 so the SPA can request an
# access token with this audience. Without it, only ID tokens exist.
AUTH0_DOMAIN=dev-rhz2klju8nybrfue.us.auth0.com
# Set once an API is registered in Auth0. Until then the API accepts the SPA's
# ID token instead, verified against Auth0's JWKS using AUTH0_CLIENT_ID.
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=tabzzDS3jDMt5YgsLg097axXgaJ63WG5

# LOCAL DEVELOPMENT ONLY. Never set in Railway — it disables token verification.
# ALLOW_DEV_AUTH=true

HISTORY_DAYS=90
CONSENT_DAYS=90
